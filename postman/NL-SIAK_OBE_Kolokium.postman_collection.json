    {
      "name": "2️⃣  INPUT NILAI - TIF117 (Pendekatan Komposisi)",
      "item": [
        {
          "name": "GET Nilai Kelas TIF117 (sebelum input)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/akademik/dosen/kelas/{{kelasId_tif117}}/nilai",
              "host": ["{{baseUrl}}"],
              "path": ["akademik", "dosen", "kelas", "{{kelasId_tif117}}", "nilai"]
            },
            "description": "Lihat daftar peserta + status nilai saat ini"
          }
        },
        {
          "name": "POST Input Nilai ikhsanmhs (Tugas+UTS+UAS+Kehadiran)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nilai\": [\n    { \"komposisiId\": \"{{komposisiId_tugas}}\", \"skor\": 85 },\n    { \"komposisiId\": \"{{komposisiId_uts}}\", \"skor\": 90 },\n    { \"komposisiId\": \"{{komposisiId_uas}}\", \"skor\": 95 },\n    { \"komposisiId\": \"{{komposisiId_kehadiran}}\", \"skor\": 90 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/akademik/dosen/kelas/{{kelasId_tif117}}/nilai/{{rincianKrsId_ikhsan_tif117}}",
              "host": ["{{baseUrl}}"],
              "path": ["akademik", "dosen", "kelas", "{{kelasId_tif117}}", "nilai", "{{rincianKrsId_ikhsan_tif117}}"]
            },
            "description": "Input nilai per komponen evaluasi.\nSistem otomatis:\n1. Hitung nilai akhir = SUM(skor × bobot) / 100\n2. Petakan ke CPMK via komposisi\n3. Cek syarat lulus → jika komponen < 60 dan MENJADI_SYARAT_LULUS → grade E\n4. Tentukan grade berdasarkan skala nilai prodi"
          }
        },
        {
          "name": "POST Input Nilai mahasiswa lain (ubah skor untuk demo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nilai\": [\n    { \"komposisiId\": \"{{komposisiId_tugas}}\", \"skor\": 40 },\n    { \"komposisiId\": \"{{komposisiId_uts}}\", \"skor\": 55 },\n    { \"komposisiId\": \"{{komposisiId_uas}}\", \"skor\": 60 },\n    { \"komposisiId\": \"{{komposisiId_kehadiran}}\", \"skor\": 70 }\n  ]\n}\n\n// ⚠️ Ganti URL: nilai/:rincianKrsId → pakai rincianKrsId mahasiswa lain dari peserta kelas"
            },
            "url": {
              "raw": "{{baseUrl}}/akademik/dosen/kelas/{{kelasId_tif117}}/nilai/GANTI_RINCIAN_KRS_ID",
              "host": ["{{baseUrl}}"],
              "path": ["akademik", "dosen", "kelas", "{{kelasId_tif117}}", "nilai", "GANTI_RINCIAN_KRS_ID"]
            },
            "description": "Demo syaratLulus: set UTS=55 (< 60) → jika UTS MENJADI_SYARAT_LULUS → sistem paksa grade E"
          }
        },
        {
          "name": "GET Nilai Kelas TIF117 (setelah input - lihat hasilnya)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/akademik/dosen/kelas/{{kelasId_tif117}}/nilai",
              "host": ["{{baseUrl}}"],
              "path": ["akademik", "dosen", "kelas", "{{kelasId_tif117}}", "nilai"]
