@startuml
title Membuat Mata Kuliah Baru (Dengan Pengembang RPS) - MataKuliahService.createMataKuliah

partition "Kepala Program Studi" {
  start
  :Membuka Form Tambah Mata Kuliah;
}

partition "Sistem" {
  :Menampilkan Form & Opsi Dosen;
}

partition "Kepala Program Studi" {
  :Mengisi Atribut MK & Memilih Dosen Pengembang RPS;
  :Klik Simpan (POST /mata-kuliah);
}

partition "Sistem" {
  :Memvalidasi Unique Constraint (Kode MK);
  if (Duplikasi kode MK?) then (ya)
    :Pengecekan Duplikasi DB;
    :Mengirim Error Response Status 409 Conflict;
  else (tidak)
    :Menambahkan Data ke siak_mata_kuliah & pivot_pengembang_rps;
    :Menarik Ulang Data Detail (Format OBE);
    :Kirim Response 201 Created;
  endif
}

partition "Kepala Program Studi" {
  :Melihat Tabel Mata Kuliah Diperbarui;
  stop
}

@enduml
